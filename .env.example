# The CLI loads .env from the current directory; shell variables take precedence.
# Optional GitHub authentication:
GITHUB_TOKEN=

# Triage model and provider-specific credentials:
LLM_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=
# For another provider, use its LiteLLM model prefix and environment credentials.
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
